# Copia este archivo a ".env.local" y rellena los valores reales.
# NUNCA subas ".env.local" a GitHub (ya está en .gitignore).

# --- Supabase ---
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Clave de servicio (solo en el servidor, NUNCA en el navegador).
# No la pongas en variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
